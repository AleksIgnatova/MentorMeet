NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mentormeet?schema=public"
# Allowed CORS origin(s). Comma-separated if more than one.
FRONTEND_URL="http://localhost:5173"
# Optional. When empty, the AI confirmation message falls back to a static text.
# Put your real key only in backend/.env (git-ignored), never in this file.
GEMINI_API_KEY=""
# Optional. Gemini model ID; defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=""
# Optional. Number of reverse proxies in front of the app (e.g. 1 on Render).
# Needed so rate limiting sees the real client IP. Leave 0 locally.
TRUST_PROXY=0
